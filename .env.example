# This file is a template — the only env file committed to version control.
# The real .env is git-ignored and is for local development only.
# Production values live in the platform secret manager (Fly.io secrets /
# Vercel project env vars) and are never committed. See D-09/D-11.
#
# Variables that MUST be set as production secrets on the backend host
# (names only — see below for details on each):
#   GROQ_API_KEY
#   NEWS_API_KEY
#   FRED_API_KEY
#   JWT_SECRET_KEY
#   DATABASE_URL
#   REDIS_URL
#   ALLOWED_ORIGINS

DATABASE_URL=postgresql+asyncpg://vantage:vantage@localhost:5434/vantage
REDIS_URL=redis://localhost:6379/0
# JWT signing key. The value below is a self-describing change-me string for
# local development only. Production MUST use a freshly generated
# cryptographically-random value, never this one. Generate one with the
# standard library:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-use-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=86400
# EDGAR_USER_AGENT is NOT read from the environment (WR-01) — it is a fixed
# constant in app/services/edgar_client.py. Setting this variable has no effect.

# Groq — real LLM calls added in Phase 4 (app/services/groq_client.py call_groq)
GROQ_API_KEY=

# NewsAPI key — required only for live smoke tests / real SentimentNLP+Risk runs
NEWS_API_KEY=
# FRED key — required only for live smoke tests / real MacroSector runs
FRED_API_KEY=

# LangSmith tracing — OPTIONAL, off by default (app/services/groq_client.py
# call_groq). Uncomment and set both to enable. WARNING: when enabled, the
# full prompt text and completion text of every Groq call (filing excerpts,
# agent narratives) leave this application's infrastructure and are sent to
# LangSmith's hosted backend. Do not enable in an environment handling data
# that must not cross that boundary.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# Allowed browser origins for CORS (D-11, DEPLOY-02) — a comma-separated
# series of origins the API accepts preflight/actual requests from. Unset
# defaults to the Vite dev server, matching the value below. In production
# this is set to the deployed frontend URL with its exact scheme and host
# and NO trailing slash — the CORS middleware performs exact string
# matching with no normalisation, so a trailing slash silently breaks it.
ALLOWED_ORIGINS=http://localhost:5173
